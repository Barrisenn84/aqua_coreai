# 🦐 AQUA-CORE AI - Configurações de Ambiente
PORT=3000
NODE_ENV=development
DATA_DIR=".data"

# Autenticação
# Mínimo aceito: 7 caracteres alfanuméricos. Em produção, prefira uma chave longa e aleatória.
JWT_SECRET="troque-por-uma-chave-alfanumerica-forte"
ADMIN_EMAIL="admin@aquacore.ai"
# Gere com: node -e "import('bcryptjs').then(({default:b})=>b.hash('SUA_SENHA',12).then(console.log))"
ADMIN_PASSWORD_HASH="$2b$12$SUBSTITUA_PELO_HASH_BCRYPT"
# Nunca habilite esta opção em uma implantação pública.
ALLOW_INSECURE_DEMO_AUTH=true
# Necessária apenas para desenvolvimento local; nunca habilite demo auth em produção.
DEMO_AUTH_PASSWORD="defina-uma-senha-local-forte"

# Automações que podem chamar APIs externas e enviar mensagens.
ENABLE_AI_SENTINEL_AUTORUN=false
ENABLE_DAILY_DIGEST=false

# Chave de API Google Gemini (Google AI Studio)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# Integração WhatsApp Ghost UX (Número do Produtor / Admin)
PRODUCER_WHATSAPP_PHONE=""
WHATSAPP_VERIFY_TOKEN="troque-por-um-token-de-verificacao"

# Financeiro
SYSTEM_PIX_KEY=""

# Configurações de Default Tenant/Farm
DEFAULT_TENANT_ID="tenant-river-life"
DEFAULT_FARM_ID="farm_shrimp_jp"

# Banco de Dados Relacional PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:senha@db.supabase.co:5432/postgres"

# URL da Aplicação
APP_URL="http://localhost:3000"
